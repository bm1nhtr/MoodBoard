# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# URI de connexion MongoDB (obligatoire)
# Option 1 — MongoDB local
MONGODB_URI=mongodb://localhost:27017/moodboard

# Option 2 — MongoDB Atlas (remplacer les champs entre <>)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/moodboard?retryWrites=true&w=majority

# Port du serveur Express (optionnel, défaut : 3000)
PORT=3000

# Google OAuth — créer un projet sur https://console.cloud.google.com
# APIs & Services → Credentials → Create OAuth 2.0 Client ID → Web Application
# Authorized redirect URI : http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Clé secrète pour les sessions Express (générer une chaîne aléatoire)
SESSION_SECRET=change_me_to_a_random_secret_string

# URL du frontend (pour les redirections OAuth)
CLIENT_URL=http://localhost:5173

# URL du backend (pour construire le callback URL OAuth)
BACKEND_URL=http://localhost:3000
